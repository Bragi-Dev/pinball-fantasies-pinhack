 #include "vga.h"
 
 #include "cpu/cpu.h"
@@ -206,20 +207,23 @@ void vga_write_p3d5(io_port_t, io_val_t value, io_width_t)
 		// 5-6	Delay of cursor data in character clocks.
 		break;
 
